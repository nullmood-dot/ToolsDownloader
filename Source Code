// ---------- paths / helpers ----------
static wstring San(wstring s) { for (auto& c : s) if (wcschr(L"\\/:*?\"<>|", c)) c = L'_'; return s; }
static bool EndsI(const wstring& s, const wstring& e) { return s.size() >= e.size() && _wcsicmp(s.c_str() + s.size() - e.size(), e.c_str()) == 0; }
struct P { wstring dir, file, target; bool zip; };
static P PathsOf(const Item& it) {
  P p; wstring u = it.t->u; size_t q = u.find_first_of(L"?#"); if (q != wstring::npos) u.resize(q);
  p.file = u.substr(u.find_last_of(L'/') + 1); if (p.file.find(L'.') == wstring::npos) p.file += L".exe";
  p.zip = EndsI(p.file, L".zip"); p.dir = wstring(ROOT) + L"\\" + San(CATS[it.cat].n);
  p.target = p.zip ? p.dir + L"\\" + San(it.t->n) : p.dir + L"\\" + p.file; return p;
}
static bool Have(const Item& it) {
  P p = PathsOf(it); std::error_code ec;
  if (!p.zip) return fs::is_regular_file(p.target, ec);
  return fs::is_directory(p.target, ec) && fs::directory_iterator(p.target, ec) != fs::directory_iterator();
}
static void Refresh() { for (auto& it : *I) { bool h = Have(it); it.st = h ? ST_HAVE : ST_READY; it.pct = h ? 100 : 0; } }
static bool Vis(int i) { return view < 0 || (*I)[i].cat == view; }
static int FailCount() { int n = 0; for (auto& it : *I) if (it.st == ST_FAIL) n++; return n; }

// ---------- download ----------
struct H { HINTERNET h; ~H() { if (h) WinHttpCloseHandle(h); } };
static void Download(const wstring& url, const wstring& out, Item& it, const std::function<void(int)>& prog) {
  wchar_t host[256], path[2048], extra[1024];
  URL_COMPONENTSW uc{}; uc.dwStructSize = sizeof uc;
  uc.lpszHostName = host; uc.dwHostNameLength = 256; uc.lpszUrlPath = path; uc.dwUrlPathLength = 2048; uc.lpszExtraInfo = extra; uc.dwExtraInfoLength = 1024;
  if (!WinHttpCrackUrl(url.c_str(), 0, 0, &uc) || uc.nScheme != INTERNET_SCHEME_HTTPS) throw wstring(L"Blocked: not an HTTPS URL");
  H s{WinHttpOpen(L"SStools/1.0", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, 0, 0, 0)}; if (!s.h) throw wstring(L"Network init failed");
  WinHttpSetTimeouts(s.h, 30000, 30000, 30000, 60000);
  DWORD proto = 0x2800; WinHttpSetOption(s.h, WINHTTP_OPTION_SECURE_PROTOCOLS, &proto, sizeof proto);
  H c{WinHttpConnect(s.h, host, uc.nPort, 0)}; if (!c.h) throw wstring(L"Connection failed");
  wstring rp = wstring(path) + extra;
  H r{WinHttpOpenRequest(c.h, L"GET", rp.c_str(), 0, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE)};
  if (!r.h || !WinHttpSendRequest(r.h, 0, 0, 0, 0, 0, 0) || !WinHttpReceiveResponse(r.h, 0)) throw wstring(L"Request failed (no connection?)");
  DWORD code = 0, sz = sizeof code;
  WinHttpQueryHeaders(r.h, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, 0, &code, &sz, 0);
  if (code != 200) throw L"HTTP " + std::to_wstring(code);
  wchar_t fin[2048]; DWORD fl = sizeof fin;
  if (WinHttpQueryOption(r.h, WINHTTP_OPTION_URL, fin, &fl) && _wcsnicmp(fin, L"https://", 8) != 0) throw wstring(L"Blocked: redirect to non-HTTPS");
  DWORD64 total = 0; DWORD tl = 0; sz = sizeof tl;
  if (WinHttpQueryHeaders(r.h, WINHTTP_QUERY_CONTENT_LENGTH | WINHTTP_QUERY_FLAG_NUMBER, 0, &tl, &sz, 0)) total = tl;
  std::ofstream f(fs::path(out), std::ios::binary); if (!f) throw wstring(L"Cannot write file (permissions?)");
  vector<char> buf(65536); DWORD n; DWORD64 got = 0;
  while (WinHttpReadData(r.h, buf.data(), (DWORD)buf.size(), &n) && n) {
    f.write(buf.data(), n); got += n;
    int p = total ? (int)(got * 100 / total) : 50; it.pct = p; prog(p);
  }
  f.close(); if (total && got != total) throw wstring(L"Incomplete download");
}

static wstring Wide(const char* s) { int n = MultiByteToWideChar(CP_UTF8, 0, s, -1, 0, 0); wstring w(n, 0); MultiByteToWideChar(CP_UTF8, 0, s, -1, &w[0], n); w.resize(n - 1); return w; }

static void Unzip(const wstring& zp, const wstring& work) {
  std::ifstream in(fs::path(zp), std::ios::binary); vector<char> d((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
  mz_zip_archive z{}; if (!mz_zip_reader_init_mem(&z, d.data(), d.size(), 0)) throw wstring(L"Extraction failed (archive kept)");
  for (mz_uint i = 0; i < mz_zip_reader_get_num_files(&z); i++) {
    mz_zip_archive_file_stat st; mz_zip_reader_file_stat(&z, i, &st);
    std::string nm = st.m_filename; for (auto& ch : nm) if (ch == '\\') ch = '/';
    bool bad = nm.empty() || nm[0] == '/' || nm.find(':') != std::string::npos || nm == ".." || nm.rfind("../", 0) == 0 || nm.find("/../") != std::string::npos || (nm.size() > 3 && nm.compare(nm.size() - 3, 3, "/..") == 0);
    if (bad) { mz_zip_reader_end(&z); throw wstring(L"Unsafe path in archive (kept)"); }
    fs::path p = fs::path(work) / fs::path(Wide(nm.c_str()));
    if (mz_zip_reader_is_file_a_directory(&z, i)) { fs::create_directories(p); continue; }
    fs::create_directories(p.parent_path());
    size_t n = 0; void* b = mz_zip_reader_extract_to_heap(&z, i, &n, 0);
    if (!b && st.m_uncomp_size) { mz_zip_reader_end(&z); throw wstring(L"Extraction failed (archive kept)"); }
    std::ofstream o(p, std::ios::binary); if (b) o.write((char*)b, n); mz_free(b);
  }
  mz_zip_reader_end(&z);
}

static bool Fetch(Item& it, const std::function<void(int)>& prog) {
  P p = PathsOf(it); fs::create_directories(p.dir);
  if (Have(it)) { it.st = ST_SKIP; it.pct = 100; prog(100); return true; }
  wstring part = p.dir + L"\\" + p.file + L".part"; std::error_code ec;
  it.pct = 0; it.st = ST_DL;
  try {
    Download(it.t->u, part, it, prog);
    char m[2] = {0, 0}; { std::ifstream f(fs::path(part), std::ios::binary); f.read(m, 2); }
    if (p.zip ? !(m[0] == 'P' && m[1] == 'K') : !(m[0] == 'M' && m[1] == 'Z'))
      throw wstring(p.zip ? L"Not a valid ZIP file" : L"Not a Windows executable (got a web page?)");
  } catch (...) { fs::remove(part, ec); throw; }
  if (p.zip) {
    it.st = ST_EXT; it.pct = 100; wstring zp = p.dir + L"\\" + p.file, work = p.target + L".extracting";
    fs::rename(part, zp, ec); if (ec) { fs::remove(zp, ec); fs::rename(part, zp); }
    try {
      fs::remove_all(work, ec); Unzip(zp, work); fs::remove_all(p.target, ec); fs::rename(work, p.target);
      fs::remove(zp, ec);  // only reached when extraction succeeded
    } catch (...) { fs::remove_all(work, ec); throw wstring(L"Extraction failed (archive kept)"); }
  } else { fs::remove(p.target, ec); fs::rename(part, p.target); }
  it.st = ST_DONE; it.pct = 100; return false;
}

static void Work(vector<int> sel) {
  int done = 0, ok = 0, skip = 0, fail = 0; wstring fails; int N = (int)sel.size();
  for (int i : sel) {
    Item& it = (*I)[i];
    { std::lock_guard<std::mutex> l(mu); cur = wstring(CATS[it.cat].n) + L"  >  " + it.t->n + L"   (" + std::to_wstring(done + 1) + L"/" + std::to_wstring(N) + L")"; }
    wstring e;
    try { (Fetch(it, [&](int p) { overall = (int)((done + p / 100.0) / N * 100); }) ? skip : ok)++; }
    catch (const wstring& w) { e = w; } catch (const std::exception& x) { e = Wide(x.what()); } catch (...) { e = L"Unexpected error"; }
    if (!e.empty()) { std::lock_guard<std::mutex> l(mu); it.err = e; it.st = ST_FAIL; fail++; fails += wstring(it.t->n) + L": " + e + L"\n"; }
    done++; overall = done * 100 / N;
  }
  { std::lock_guard<std::mutex> l(mu);
    cur = fail ? L"Finished with errors." : L"All selected utilities finished.";
    summary = L"Completed: " + std::to_wstring(ok) + L"    Already present: " + std::to_wstring(skip) + L"    Failed: " + std::to_wstring(fail) + L"\n\nLocation: " + ROOT;
    if (fail) summary += L"\n\nFailed:\n" + fails + L"\nUse \"Retry Failed\" to try again."; }
  PostMessageW(hw, WM_APP + 1, fail, 0);
}

static void StartRun(vector<int> sel) {
  if (sel.empty()) { MessageBoxW(hw, L"Select at least one utility first.", L"SStools", MB_OK); return; }
  std::error_code ec; fs::create_directories(ROOT, ec);
  if (ec) { MessageBoxW(hw, L"Cannot create C:\\Forensic utilities and tools\n(try running as administrator).", L"SStools", MB_ICONERROR); return; }
  for (int i : sel) { (*I)[i].st = ST_PEND; (*I)[i].pct = 0; }
  overall = 0; overDisp = 0; busy = true; std::thread(Work, sel).detach();
}

