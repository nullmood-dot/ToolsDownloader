    float top = s(108), bot = Hh - s(96); float yy = top - scrollY;
    g.SetClip(RectF(0, top, (float)W, bot - top));
    for (int c = 0; c < (int)CATS.size(); c++) {
      if (view >= 0 && c != view) continue;
      if (view < 0) { yy += s(6); Txt(g, wstring(CATS[c].n), fN, RectF(x0 + s(2), yy, w, s(24)), DIM); yy += s(28); }
      for (int i = 0; i < (int)I->size(); i++) {
        Item& it = (*I)[i]; if (it.cat != c) continue; RectF r(x0, yy, w, s(34));
        if (r.GetBottom() > top && r.Y < bot) {
          FillRR(g, r, s(5), Hot(H_CHK, i) ? HOVER : ROWC);
          RectF cb(x0 + s(12), yy + s(9), s(16), s(16));
          if (it.sel) { FillRR(g, cb, s(3), PUR); Pen pw(Color(255, 255, 255), s(1.8f)); PointF pt[3] = {{cb.X + s(3.5f), cb.Y + s(8)}, {cb.X + s(6.5f), cb.Y + s(11)}, {cb.X + s(12.5f), cb.Y + s(4.5f)}}; g.DrawLines(&pw, pt, 3); }
          else LineRR(g, cb, s(3), C(96, 92, 120));
          Txt(g, it.t->n, fN, RectF(x0 + s(40), yy, s(250), s(34)), TXT);
          Txt(g, it.t->inst ? L"Installer" : L"Portable", fL, RectF(x0 + s(290), yy, s(90), s(34)), it.t->inst ? WARN : DIM);
          wstring t; Color col = DIM; int st = it.st, pc = it.pct;
          switch (st) {
            case ST_HAVE: t = L"Downloaded"; col = GOOD; break; case ST_PEND: t = L"Pending"; break;
            case ST_DL: t = L"Downloading " + std::to_wstring(pc) + L"%"; col = AQ; break; case ST_EXT: t = L"Extracting"; col = C(170, 140, 255); break;
            case ST_DONE: t = it.t->inst ? L"Done - run installer" : L"Done"; col = GOOD; break;
            case ST_SKIP: t = L"Already downloaded"; col = GOOD; break;
            case ST_FAIL: { std::lock_guard<std::mutex> l(mu); t = L"Failed: " + it.err; col = BAD; break; }
            default: t = L""; }
          Txt(g, t, fL, RectF(x0 + w - s(340), yy, s(230), s(34)), col, 2);
          if (st == ST_DL || st == ST_EXT || st == ST_DONE || st == ST_SKIP || st == ST_HAVE) Bar(g, RectF(x0 + w - s(96), yy + s(15), s(80), s(4)), (float)pc, false);
          hits.push_back({r, H_CHK, i});
        }
        yy += s(38);
      }
    }
    contentH = (int)(yy + scrollY - top); g.ResetClip();
    { std::lock_guard<std::mutex> l(mu); Txt(g, cur, fL, RectF(x0, Hh - s(84), w, s(22)), DIM); }
    Bar(g, RectF(x0, Hh - s(54), w - s(52), s(6)), overDisp, true);
    Txt(g, std::to_wstring((int)overDisp) + L"%", fL, RectF(x0 + w - s(44), Hh - s(62), s(44), s(22)), TXT, 2);
  }
  BitBlt(dc, 0, 0, W, Hh, m, 0, 0, SRCCOPY); DeleteObject(bm); DeleteDC(m);
}

static int HitAt(int x, int y) { for (int i = (int)hits.size() - 1; i >= 0; i--) if (hits[i].r.Contains((REAL)x, (REAL)y)) return i; return -1; }

static void DeleteAll() {
  if (MessageBoxW(hw, (wstring(L"This will PERMANENTLY delete the entire folder:\n\n") + ROOT +
      L"\n\nand everything inside it (all categories, extracted folders and files).\nNothing outside this folder will be touched.\n\nContinue?").c_str(),
      L"Delete All Tools", MB_YESNO | MB_ICONWARNING | MB_DEFBUTTON2) != IDYES) return;
  try {
    std::error_code ec; fs::path p = fs::weakly_canonical(ROOT, ec);
    if (_wcsicmp(p.c_str(), ROOT) != 0) throw std::runtime_error("Unexpected path, aborting.");
    if (fs::exists(p, ec)) {
      if (GetFileAttributesW(p.c_str()) & FILE_ATTRIBUTE_REPARSE_POINT) throw std::runtime_error("Folder is a link, refusing to delete.");
      fs::remove_all(p);
    }
    Refresh(); { std::lock_guard<std::mutex> l(mu); cur = L"Ready"; } overall = 0; overDisp = 0; scrollY = 0;
    MessageBoxW(hw, L"All tools were deleted.", L"Delete All Tools", MB_OK | MB_ICONINFORMATION);
  } catch (const std::exception& e) { MessageBoxW(hw, (L"Deletion failed:\n" + Wide(e.what())).c_str(), L"SStools", MB_OK | MB_ICONERROR); }
}

static LRESULT CALLBACK Proc(HWND h, UINT m, WPARAM w, LPARAM l) {
  switch (m) {
    case WM_PAINT: { PAINTSTRUCT ps; HDC dc = BeginPaint(h, &ps); RECT rc; GetClientRect(h, &rc); Paint(dc, rc.right, rc.bottom); EndPaint(h, &ps); return 0; }
    case WM_ERASEBKGND: return 1;
    case WM_GETMINMAXINFO: ((MINMAXINFO*)l)->ptMinTrackSize = {(LONG)s(980), (LONG)s(680)}; return 0;
    case WM_TIMER: { float t = (float)overall; if (fabsf(t - overDisp) > 0.1f) overDisp += (t - overDisp) * 0.2f; else overDisp = t; InvalidateRect(h, 0, FALSE); return 0; }
    case WM_APP + 1: { busy = false; std::wstring sm; { std::lock_guard<std::mutex> lk(mu); sm = summary; }
      MessageBoxW(h, sm.c_str(), w ? L"Finished with errors" : L"Download complete", MB_OK | (w ? MB_ICONWARNING : MB_ICONINFORMATION)); return 0; }
    case WM_MOUSEWHEEL: { RECT rc; GetClientRect(h, &rc); int vis = (int)(rc.bottom - s(204));
      scrollY = max(0, min(max(0, contentH - vis), scrollY - (GET_WHEEL_DELTA_WPARAM(w) > 0 ? 1 : -1) * (int)s(60))); return 0; }
    case WM_SETCURSOR: { POINT p; GetCursorPos(&p); ScreenToClient(h, &p); SetCursor(LoadCursor(0, HitAt(p.x, p.y) >= 0 ? IDC_HAND : IDC_ARROW)); return TRUE; }
    case WM_MOUSEMOVE: { int i = HitAt(LOWORD(l), HIWORD(l)); int t = i < 0 ? -1 : hits[i].type, d = i < 0 ? -1 : hits[i].id;
      if (t != hotT || d != hotI) { hotT = t; hotI = d; InvalidateRect(h, 0, FALSE); }
      TRACKMOUSEEVENT te{sizeof te, TME_LEAVE, h, 0}; TrackMouseEvent(&te); return 0; }
    case WM_MOUSELEAVE: hotT = hotI = -1; InvalidateRect(h, 0, FALSE); return 0;
    case WM_LBUTTONDOWN: {
      int i = HitAt(LOWORD(l), HIWORD(l)); if (i < 0) return 0; Hit ht = hits[i];
      if (ht.type == H_BRAND) { ShellExecuteW(h, L"open", BRAND_URL, 0, 0, SW_SHOWNORMAL); return 0; }
      if (busy) return 0;
      vector<int> sel;
      switch (ht.type) {
        case H_NAV: view = ht.id; scrollY = 0; break;
        case H_CHK: (*I)[ht.id].sel = !(*I)[ht.id].sel; break;
        case H_SEL: case H_DES: for (int k = 0; k < (int)I->size(); k++) if (Vis(k)) (*I)[k].sel = ht.type == H_SEL; break;
        case H_DL: for (int k = 0; k < (int)I->size(); k++) if (Vis(k) && (*I)[k].sel) sel.push_back(k); StartRun(sel); break;
        case H_RETRY: for (int k = 0; k < (int)I->size(); k++) if ((*I)[k].st == ST_FAIL) sel.push_back(k); StartRun(sel); break;
        case H_DEL: DeleteAll(); break;
      }
      InvalidateRect(h, 0, FALSE); return 0; }
    case WM_DESTROY: PostQuitMessage(0); return 0;
  }
  return DefWindowProcW(h, m, w, l);
}

